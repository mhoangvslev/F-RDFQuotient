			<name>CEDAR-commons MVN snapshot repo</name>
			<url>http://maven.inria.fr/artifactory/cedarcommons-private-snapshot</url>
		</repository> -->
		</repositories>

	<distributionManagement>
		<repository>
			<id>gitlab-maven</id>
			<url>https://gitlab.inria.fr/api/v4/projects/46547/packages/maven</url>
		</repository>
		<snapshotRepository>
			<id>gitlab-maven</id>
			<url>https://gitlab.inria.fr/api/v4/projects/46547/packages/maven</url>
		</snapshotRepository>
	</distributionManagement>


